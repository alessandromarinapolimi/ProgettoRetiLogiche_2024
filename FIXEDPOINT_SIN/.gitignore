# Exclude only .vhd, .v, and .sv files in the .srcs directory
!**.srcs/**/*.vhd
!**.srcs/**/*.v 
!**.srcs/**/*.sv

# Ignore backup files
vivado*.backup.log
vivado*.jou
vivado*.log

